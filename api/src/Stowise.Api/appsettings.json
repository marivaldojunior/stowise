{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false,
    "SeedSampleData": false
  },
  "Ia": {
    "Habilitada": false,
    "Principal": {
      "Provedor": "Anthropic",
      "Modelo": "claude-opus-5-5",
      "MaxTokensSaida": 4096,
      "PrecoEntradaPorMilhao": 4.00,
      "PrecoSaidaPorMilhao": 20.00
    },
    "Reserva": {
      "Provedor": "Ollama",
      "Modelo": "llama3.2",
      "Endpoint": "http://localhost:11434",
      "MaxTokensSaida": 4096,
      "PrecoEntradaPorMilhao": 0,
      "PrecoSaidaPorMilhao": 0
    }
  },
  "Jobs": {
    "Enabled": true,
    "Workers": 2,
    "PollIntervalSeconds": 5
  },
  "Jwt": {
    "Issuer": "stowise-api",
    "Audience": "stowise-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false,
    "SeedSampleData": false
  },
  "Jwt": {
    "Issuer": "stowise-api",
    "Audience": "stowise-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  }
}

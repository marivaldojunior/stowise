{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false,
    "SeedSampleData": false
  },
  "Ia": {
    "Habilitada": false,
    "TimeoutSegundos": 60,
    "TentativasPorProvedor": 3,
    "EsperaInicialMs": 500,
    "FusoHorarioCota": "America/Sao_Paulo",
    "Provedores": [
      {
        "Nome": "anthropic",
        "Tipo": "Anthropic",
        "Modelo": "claude-opus-5-5",
        "MaxTokensSaida": 4096,
        "PrecoEntradaPorMilhao": 4.00,
        "PrecoSaidaPorMilhao": 20.00
      },
      {
        "Nome": "ollama-local",
        "Tipo": "Ollama",
        "Modelo": "llama3.2",
        "Endpoint": "http://localhost:11434",
        "MaxTokensSaida": 4096,
        "PrecoEntradaPorMilhao": 0,
        "PrecoSaidaPorMilhao": 0
      }
    ],
    "Funcionalidades": {
      "Mapeamento": {
        "TimeoutSegundos": 30
      }
    }
  },
  "Jobs": {
    "Enabled": true,
    "Workers": 2,
    "PollIntervalSeconds": 5
  },
  "Jwt": {
    "Issuer": "stowise-api",
    "Audience": "stowise-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  }
}

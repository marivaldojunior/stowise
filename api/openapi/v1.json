{
  "openapi": "3.1.1",
  "info": {
    "title": "Stowise API",
    "description": "Inventário e armazenagem com IA: a IA sugere e uma pessoa confirma.\n\nErros seguem o padrão ProblemDetails (RFC 9457) e sempre trazem `traceId`.",
    "version": "1.0"
  },
